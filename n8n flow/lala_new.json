    {
      "parameters": {
        "jsCode": "const text = ($json.text || '').trim();\nlet channel = 'voicebot';\nlet reasoning = 'Auto-classified based on lead profile.';\ntry {\n  const parsed = JSON.parse(text);\n  channel = ((parsed.channel || 'voicebot') + '').toLowerCase().trim();\n  reasoning = parsed.reasoning || reasoning;\n} catch (e) {\n  if (text.toLowerCase().includes('whatsapp')) channel = 'whatsapp_bot';\n  else if (text.toLowerCase().includes('gmail') || text.toLowerCase().includes('email')) channel = 'gmail';\n  else channel = 'voicebot';\n}\nreturn [{ json: { channel, reasoning } }];"
      },
