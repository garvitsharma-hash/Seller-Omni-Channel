      "typeVersion": 1,
      "position": [-400, 0],
      "webhookId": "dispatch-webhook-12345"
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ ($json.body.mode || '').toLowerCase() === 'auto' ? true : false }}",
