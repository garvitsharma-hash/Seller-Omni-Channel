    {
      "parameters": {
        "jsCode": "// Extract clean phone number from remoteJid\nconst remoteJid = $('Webhook1').first().json.body.data.key.remoteJid;\nconst phone = remoteJid.replace('@s.whatsapp.net', '').replace('@g.us', '');\n\n// Strip leading 91 for Indian numbers to match glid_data.mobile\nconst phoneClean = phone.startsWith('91') && phone.length > 10 ? phone.substring(2) : phone;\n\nconst message = $('Webhook1').first().json.body.data.message.conversation \n  || $('Webhook1').first().json.body.data.message.extendedTextMessage?.text \n  || '';\n\n// EXTRACT EMAIL LOGIC ADDED HERE\nconst emailRegex = /([a-zA-Z0-9._-]+@[a-zA-Z0-9._-]+\\.[a-zA-Z0-9_-]+)/;\nconst match = message.match(emailRegex);\nconst email = match ? match[0] : null;\n\nreturn [{\n  json: {\n    phone_full: phone,\n    phone_clean: phoneClean,\n    remote_jid: remoteJid,\n    instance: $('Webhook1').first().json.body.instance,\n    message: message,\n    email: email\n  }\n}];"
      },
